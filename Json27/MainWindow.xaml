<Window x:Class="Json27.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Json27"
        mc:Ignorable="d"
        Title="" Height="450" Width="800">
    <Grid Background="#FF69B4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBox Text=" 👯Наши друзьяшки👯" FontSize="50" FontWeight="Bold" Background="#FF69B4" />
        <DataGrid x:Name="lbNames" 
      Grid.Row="1"
      AutoGenerateColumns="False" 
      IsReadOnly="False"
      Margin="10,1,10,32"
      AlternatingRowBackground="#E3F2FD"
      HeadersVisibility="Column" Grid.RowSpan="2">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Имя" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Возраст" Binding="{Binding Age}" Width="*"/>
                <DataGridTextColumn Header="Номер телефона" Binding="{Binding Phone}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="3" 
            Orientation="Horizontal" 
            HorizontalAlignment="Center" 
            VerticalAlignment="Center"
            Margin="10">
            <Button Content="📂Загрузить" Click="Open_Click" Width="80" Height="30" Margin="5" Background="#6495ED"/>
            <Button Content="❤️Сохранить" Click="Save_Click" Width="80" Height="30" Margin="5" Background="#87CEEB" />
            <Button Content="❌Удалить" Click="Del_Click" Width="80" Height="30" Margin="5" Background="#CD5C5C"/>
            <Button Content="✅Добавить" Click="Add_Click" Width="80" Height="30" Margin="5"  Background="#3CB371"/>
        </StackPanel>

    </Grid>
</Window>
