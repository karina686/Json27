<Window x:Class="Json27.Add"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Json27"
        mc:Ignorable="d"
        Title="" Height="350" Width="700">

    <Grid  Background="#F08080">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" 
               Text="🐒Добавление нового друзьяшки" 
               HorizontalAlignment="Center" 
               Margin="0,0,0,20" 
               FontSize="40" 
               FontWeight="Bold" 
               Foreground="Black"/>
        <TextBlock Grid.Row="1" Text="Имя:" VerticalAlignment="Center" Margin="5" FontSize="16" FontWeight="Bold"/>
        <TextBox x:Name="tbName" Grid.Row="1" Grid.Column="1" Margin="5" Height="30" VerticalContentAlignment="Center" FontSize="14"/>
        <TextBlock Grid.Row="2" Text="Возраст:" VerticalAlignment="Center" Margin="5" FontSize="16" FontWeight="Bold"/>
        <TextBox x:Name="tbAge" Grid.Row="2" Grid.Column="1" Margin="5" Height="30" VerticalContentAlignment="Center" FontSize="14"/>
        <TextBlock Grid.Row="3" Text="Номер телефона:" VerticalAlignment="Top" Margin="5,10,5,5" FontSize="16" FontWeight="Bold"/>
        <TextBox x:Name="tbPhone" Grid.Row="3" Grid.Column="1" Margin="5" Height="30" TextWrapping="Wrap" AcceptsReturn="True" FontSize="14"/>
        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Button Content="Отмена" IsCancel="True" Width="120" Height="30" Margin="10" Background="#FF0000" Click="Button_Click"/>
            <Button Content="ОК" Click="Ok_Click" Width="120" Height="30" Margin="10" Background="#32CD32" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>